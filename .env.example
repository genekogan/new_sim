# Sim server configuration. Copy to .env. See docs/sim/DEVELOPMENT.md.
PORT=4500
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_URL=http://localhost:4500

# Explicit provider switch: none, clerk, or legacy privy. Public Clerk requires
# DEV_AUTH=0, ACCOUNT_AUTH_REQUIRED=1 and the SAME Eden1 production instance.
AUTH_PROVIDER=none
ACCOUNT_AUTH_REQUIRED=0
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER_URL=
CLERK_AUTHORIZED_PARTIES=
# Absolute identity-only SQLite registry shared by every world. Keep on rollback.
ACCOUNT_REGISTRY_PATH=
# Legacy rollback only; not initialized or accepted when Clerk/none is selected.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
ADMIN_EMAILS=

# Models. BRAIN_MODE is "live" or "fake"; anything other than "fake" means live and spends money.
BRAIN_MODE=fake
BRAIN_BUDGET_USD_PER_DAY=0.5
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
NARRATOR_MODEL=claude-haiku-4-5-20251001
# COMPILER_MODEL=          # wishes → plans and new cards; defaults to NARRATOR_MODEL
# TALK_MODEL=              # spoken words; defaults to NARRATOR_MODEL

# World
ENGINE=toy                 # "mars" runs the Mars adapter (needs a local Mars checkout); anything else is the toy engine
# MARS_ENGINE_DIR=         # the Mars engine checkout; defaults to <mars-campus-repo>/viewer/engine
INVITE_REQUIRED=1          # 0 lets any signed-in user create Souls
MAX_SOULS_PER_USER=5
SEED_NATIVES=1             # seed six native Souls into an empty world
WORLD_SEED=sim-genesis-1
SNAPSHOT_EVERY_TICKS=6000  # 5 minutes at clock rate 1

# Local development only. Never set in production.
DEV_AUTH=1                 # accept "Bearer dev:<name>"; "dev:admin" is an admin
# WEB_DIR=                 # defaults to apps/web/dist
# BUILD_ID=                # defaults to the BUILD file written by deploy, else "dev"

# Enable only after living-camp qualification. Per-world process override; toy stays unchanged.
ENABLE_LIVING_WORLD=0
