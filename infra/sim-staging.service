[Unit]
Description=Sim staging: the release candidate, fake brain, own data
After=network-online.target

[Service]
Type=simple
User=sim
Group=sim
WorkingDirectory=/srv/sim/staging/apps/server
EnvironmentFile=/home/sim/sim-staging.env
ExecStart=/usr/bin/node src/main.ts
Restart=always
RestartSec=3
TimeoutStopSec=20
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/sim-data-staging
PrivateTmp=true

[Install]
WantedBy=multi-user.target
