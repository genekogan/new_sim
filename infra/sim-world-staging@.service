[Unit]
Description=Sim staging world %i
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=sim
Group=sim
WorkingDirectory=/srv/sim/staging/apps/server
EnvironmentFile=/home/sim/sim-staging.env
EnvironmentFile=/home/sim/worlds/staging-%i.env
Environment=BRAIN_MODE=fake
ExecStart=/usr/bin/node src/main.ts
Restart=always
RestartSec=3
TimeoutStopSec=20
MemoryMax=1G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/sim-data-staging
PrivateTmp=true
[Install]
WantedBy=multi-user.target
