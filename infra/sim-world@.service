[Unit]
Description=Sim world %i
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=sim
Group=sim
WorkingDirectory=/srv/sim/current/apps/server
EnvironmentFile=/home/sim/sim.env
EnvironmentFile=/home/sim/worlds/%i.env
ExecStart=/usr/bin/node src/main.ts
Restart=always
RestartSec=3
TimeoutStopSec=20
MemoryMax=1G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/sim-data
PrivateTmp=true
[Install]
WantedBy=multi-user.target
