{
  "name": "mars-campus-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node deploy/prepare-camera-demo.mjs",
    "dev": "vite",
    "prebuild": "node deploy/prepare-camera-demo.mjs --for-build",
    "build": "vite build && node deploy/configure.mjs",
    "preview": "vite preview",
    "start": "wrangler dev --config dist/server/cloudflare.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app simulation lib deploy engine cinematography --ignore-pattern simulation/env.d.ts",
    "test": "node --test deploy/*.test.mjs",
    "test:simulation": "node deploy/simulation-integration.mjs",
    "gate": "node deploy/gate.mjs",
    "format": "oxfmt app simulation lib deploy vite.config.ts",
    "test:engine": "node --test engine/test/*.test.ts",
    "evidence": "node deploy/evidence-report.mjs",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers playwright test -c e2e/playwright.config.ts",
    "e2e:update-baselines": "E2E_UPDATE_BASELINES=1 PLAYWRIGHT_BROWSERS_PATH=.pw-browsers playwright test -c e2e/playwright.config.ts",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "lucide-react": "1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.185.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.19",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.1",
    "meshoptimizer": "^1.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2003",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.136.2"
  },
  "type": "module"
}
