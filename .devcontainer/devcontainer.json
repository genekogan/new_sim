// A ready-to-work container for Sim: Node 22, pnpm 10.27.0, Playwright 1.63 Chromium (for proof clips and e2e),
// ffmpeg (clip encoding with a scrub bar), the workspace installed and the media pulled from the CDN.
// Works in VS Code Dev Containers, GitHub Codespaces and `devcontainer up`.
{
  "name": "sim",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "PLAYWRIGHT_BROWSERS_PATH": "/home/node/.cache/ms-playwright"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["redhat.vscode-yaml", "github.vscode-github-actions"]
    }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "remoteUser": "node"
}
