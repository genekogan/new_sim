   "palette": {
    "type": "json",
    "doc": "[{kind: oak|pine|birch|poplar|palm|bush|fern|reed|rock|boulder|flower|grass|cactus, or def: ref, weight, nearWater?, farWater?, minSlope?, maxSlope?, wet?, scale?: [min,max]}]"
