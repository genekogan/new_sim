[
 {
  "schema": "def/1",
  "name": "core-road",
  "version": 1,
  "description": "A road along a path: cobble/asphalt/gravel/dirt, kerbs, verges; graded to ≤ maxGrade on hills (prepareRoad) and bridged over water automatically. T and X junctions merge.",
  "tags": [
   "road",
   "path-network",
   "terrain"
  ],
  "form": "path",
  "layer": "surface",
  "make": {
   "kind": "gen",
   "gen": "road/1"
  },
  "size": {
   "box": [
    10,
    0.2,
    10
   ]
  },
  "params": {
   "width": {
    "type": "number",
    "min": 2,
    "max": 30,
    "default": 6
   },
   "material": {
    "type": "enum",
    "values": [
     "asphalt",
     "cobble",
     "gravel",
     "dirt",
     "sand"
    ],
    "default": "cobble"
   },
   "kerb": {
    "type": "bool",
    "default": true
   },
   "shoulder": {
    "type": "number",
    "min": 0,
    "max": 4,
    "default": 0.6
   },
   "maxGrade": {
    "type": "number",
    "min": 0,
    "max": 0.2,
    "default": 0.08,
    "doc": "carve/fill to keep slope below this (0 = follow terrain)"
   },
   "autoBridge": {
    "type": "bool",
    "default": true
   },
   "lines": {
    "type": "bool",
    "default": false
   },
   "grade": {
    "type": "json",
    "doc": "frozen by prepareRoad: {sig, h[], spans[]} — profile per centre-line point and bridge spans"
   }
  }
 },
