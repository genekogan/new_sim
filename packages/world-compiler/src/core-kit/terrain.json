    30
   ]
  },
  "params": {
   "level": {
    "type": "number",
    "min": -200,
    "max": 400,
    "doc": "absolute level (m); omit with step for a stepped hillside"
   },
   "step": {
    "type": "number",
    "min": 0.3,
    "max": 20,
    "doc": "ledge height (m)"
   },
   "riser": {
