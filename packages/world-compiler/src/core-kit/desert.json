 {
  "schema": "def/1",
  "version": 1,
  "name": "core-desert-scrub",
  "description": "Sparse desert scrub over an area: creosote bushes (three shapes, 0.4–1.6 m) and dry grass tufts that follow the playa drainage veins; low density (default one bush per ~670 m²), optionally denser toward a side; keeps off buildings and roads and out of `clear` circles. Five instanced meshes for any size. Decor.",
  "tags": [
   "cover",
   "plant",
   "scrub",
   "desert",
   "ecology",
   "creosote",
   "grass"
  ],
  "synonyms": [
   "desert brush",
   "creosote scrub",
   "sagebrush",
   "chaparral"
  ],
  "form": "area",
  "anchor": "drape",
  "layer": "decor",
  "make": {
   "kind": "gen",
   "gen": "desert-scrub/1"
  },
  "size": {
   "box": [
    200,
    1.6,
    200
   ]
  },
  "params": {
   "density": {
    "type": "number",
    "min": 0,
    "max": 0.2,
    "default": 0.0015,
    "doc": "bushes per m² on average (0.0015 ≈ one per 670 m²)"
   },
   "grass": {
    "type": "number",
    "min": 0,
    "max": 20,
    "default": 2,
    "doc": "grass tufts per bush"
   },
   "toward": {
    "type": "enum",
    "values": [
     "none",
     "n",
     "ne",
     "e",
     "se",
     "s",
     "sw",
     "w",
     "nw"
    ],
    "default": "none",
    "doc": "denser toward this side of the area (engine north = −z)"
   },
   "gradient": {
    "type": "number",
    "min": 0,
    "max": 1,
    "default": 0.6,
    "doc": "how much denser (1 = from none at one side to double at the other)"
   },
   "veins": {
    "type": "number",
    "min": 0,
    "max": 1,
    "default": 0.6,
    "doc": "how much plants follow the playa drainage veins"
   },
   "cluster": {
    "type": "number",
    "min": 0,
    "max": 1,
    "default": 0.35,
    "doc": "0 even … 1 clumped"
   },
   "minHeight": {
    "type": "number",
    "min": 0.2,
    "max": 3,
    "default": 0.4
   },
   "maxHeight": {
    "type": "number",
    "min": 0.2,
    "max": 3,
    "default": 1.6
   },
   "minSpacing": {
    "type": "number",
    "min": 0.5,
    "max": 30,
    "default": 2.5,
    "doc": "between bushes (m)"
   },
   "clear": {
    "type": "json",
    "doc": "[[x, z, r], …] circles kept bare (a camp, a plaza)"
   }
  }
 },
