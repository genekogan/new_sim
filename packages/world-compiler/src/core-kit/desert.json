 {
  "schema": "def/1",
  "version": 1,
  "name": "core-tire",
  "description": "An old black car tyre half-buried in the ground (about 0.62 m across): upright and sunk by `burial`, lying flat, or leaning. Decor, no collider: Souls step over it.",
  "tags": [
   "prop",
   "tire",
   "tyre",
   "desert",
   "junk",
   "decor"
  ],
  "synonyms": [
   "tyre",
   "old tire",
   "car tire",
   "rubber tire"
  ],
  "form": "point",
  "anchor": "base",
  "layer": "decor",
  "make": {
   "kind": "gen",
   "gen": "tire/1"
  },
  "size": {
   "box": [
    0.62,
    0.42,
    0.21
   ],
   "scale": [
    0.6,
    2.5
   ]
  },
  "params": {
   "diameter": {
    "type": "number",
    "min": 0.3,
    "max": 1.6,
    "default": 0.62,
    "doc": "tyre outer diameter (m)"
   },
   "burial": {
    "type": "number",
    "min": 0,
    "max": 0.9,
    "default": 0.35,
    "doc": "fraction of the diameter sunk into the ground (upright tyres)"
   },
   "pose": {
    "type": "enum",
    "values": [
     "upright",
     "flat",
     "leaning"
    ],
    "default": "upright"
   },
   "color": {
    "type": "color",
    "default": "#1d1c1b",
    "doc": "rubber colour"
   }
  }
 },
