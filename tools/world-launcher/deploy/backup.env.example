# /etc/sim-worlds/backup.env — settings for sim-worlds-backup@<stage>.service (deploy/backup-restic.mjs).
# Install: install -o root -g simworlds -m 0640 backup.env.example /etc/sim-worlds/backup.env
# Every key has this default in the script; the file only needs the lines you change.
RESTIC_REPOSITORY=/srv/sim-worlds-backups/restic
# 32 random bytes, root:simworlds 0640 (like production-auth.env); never printed, never committed. Losing it loses the backups.
RESTIC_PASSWORD_FILE=/etc/sim-worlds/restic.pass
RESTIC_CACHE_DIR=/srv/sim-worlds-backups/.cache
# The copies restic snapshots (a mirror of /srv/sim-worlds-data/<stage>, kept between nights so unchanged uploads are not recopied).
SIM_BACKUP_STAGING=/srv/sim-worlds-backups/staging
SIM_BACKUP_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 6"
# Off-box copy (optional): a Cloudflare R2 bucket. Each night copies the new snapshots there and applies the same retention.
#SIM_BACKUP_OFFSITE=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#AWS_ACCESS_KEY_ID=<R2 access key id>
#AWS_SECRET_ACCESS_KEY=<R2 secret access key>
