# Old-worlds front door on eden2 (lane CLOUD2; lane KIT 2026-10-15: source 1080cfa9). Serves the 1080cfa9 web overlay
# (OVERLAY-WEB-MANIFEST 63acd353), the Soul CLI 40cc21a6 and routes to sim-old@{eden,mars,littlemartians} on 4660-4662.
# Listens 127.0.0.1:4670 (descriptor says 4970, the proxy's only public-preview port; bin/port-map.mjs moves it).
# proxy.mjs runs from the sealed input, byte-identical to the laptop proxy (PID 15071). /worlds is Caddy -> 4620, not this.
# --preserve-symlinks-main: proxy.mjs runs its CLI main only when argv[1] equals its own URL (current/ is a symlink).
[Unit]
Description=Sim old-worlds proxy (eden2)
After=sim-old@eden.service sim-old@mars.service sim-old@littlemartians.service
Wants=sim-old@eden.service sim-old@mars.service sim-old@littlemartians.service

[Service]
Type=simple
User=simworlds
Group=simworlds
WorkingDirectory=/srv/sim-old/current/input
Environment=SIM_PORT_MAP=4950:4660,4963:4661,4964:4662,4970:4670
ExecStart=/usr/bin/node --preserve-symlinks-main --import=/srv/sim-old/current/bin/port-map.mjs /srv/sim-old/current/input/tools/core/multiworld/proxy.mjs /srv/sim-old/current/descriptors/proxy.json
Restart=always
RestartSec=5
MemoryMax=1G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
