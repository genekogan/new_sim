# Old Sim worlds on eden2 (lane CLOUD2): eden, mars, littlemartians — one writer per world.
#   code /srv/sim-old/current -> /srv/sim-old/releases/<build>; data /srv/sim-old-data/%i; ports 4660 eden, 4661 mars, 4662 LM (the code keeps the laptop ports 4950/4963/4964; bin/port-map.mjs moves them)
#   auth /etc/sim-old/clerk-public.env (Clerk publishable settings, copied by path) + shared account registry below.
# Binds 127.0.0.1 only. Never touches /opt/eden3, the sim or mars users, sim-worlds@*, Caddy or DNS.
[Unit]
Description=Sim old world %i (eden2 copy of the laptop writer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=simworlds
Group=simworlds
WorkingDirectory=/srv/sim-old/current/input
Environment=AUTH_PROVIDER=clerk
Environment=ACCOUNT_REGISTRY_PATH=/srv/sim-old-data/accounts/accounts.sqlite
Environment=SIM_PORT_MAP=4950:4660,4963:4661,4964:4662,4970:4670,5340:4620
ExecStart=/usr/bin/node --import=/srv/sim-old/current/bin/port-map.mjs --experimental-transform-types --env-file=/etc/sim-old/clerk-public.env /srv/sim-old/current/bin/run-world.mjs /srv/sim-old/current/descriptors/%i.json
# SIGTERM = normal close: the world stops its clock and saves a snapshot before exit.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=180
Restart=on-failure
RestartSec=5
MemoryHigh=2500M
MemoryMax=3G
TasksMax=512
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sim-old-data
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
