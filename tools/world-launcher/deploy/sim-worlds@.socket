# Optional companion of sim-worlds@.service (lane W, 2026-10-17): systemd holds the launcher's port, so a restart of
# sim-worlds@<stage> (a changed keeper, unit or settings file, `release.sh --restart`, a crash) queues new connections in
# this socket's backlog instead of refusing them: no Caddy 502 page; requests wait until the next keeper answers.
# keeper.mjs takes the socket when systemd passes it (LISTEN_FDS) and binds the port itself otherwise.
# The port comes from a per-stage drop-in and must equal --port in /etc/sim-worlds/<stage>.conf (the keeper refuses another):
#   /etc/systemd/system/sim-worlds@production.socket.d/10-port.conf
#     [Socket]
#     ListenStream=127.0.0.1:<port>
# Switch on (one last restart that blinks; the service must not hold the port when the socket starts):
#   systemctl daemon-reload && systemctl stop sim-worlds@production && systemctl enable --now sim-worlds@production.socket && systemctl start sim-worlds@production
# Switch off: systemctl disable --now sim-worlds@production.socket && systemctl restart sim-worlds@production
# Take the stage away entirely: systemctl disable --now sim-worlds@<stage>.socket sim-worlds@<stage> (a connection to an
# active socket would start the service again).
[Unit]
Description=Sim world launcher port (%i), held across restarts

[Socket]
Backlog=1024
NoDelay=true

[Install]
WantedBy=sockets.target
