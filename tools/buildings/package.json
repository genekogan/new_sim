{
  "name": "lm-buildings-generator",
  "private": true,
  "description": "Procedural Ceramic Tower and Minaret Temple for /w/littlemartians (Blender Python; no npm dependencies)",
  "scripts": {
    "generate": "blender -b --factory-startup --python generate.py --",
    "generate:quick": "blender -b --factory-startup --python generate.py -- --quick",
    "validate": "blender -b --factory-startup --python generate.py -- --no-render",
    "selftest": "blender -b --factory-startup --python selftest.py",
    "check": "node check-glb.mjs"
  }
}
