+// Legacy-look data migration (L10 patch 04, needs Gene + Codex: it rewrites existing Souls' body records).
+// Every live Soul whose body is today's plain humanoid (no body field: template by id hash, palette from the
+// social-preset adapter for the 8 audited Souls) gets that exact look written as a core/humanoid@2 body
+// {family, model: look key, params}, through the ordinary logged 'body-assignment-v1' event, so replay and
+// snapshots carry it and the viewer composes it from the kit. Sizes stay today's (no height/build/walkSpeed),
+// so the engine body is unchanged (HUMAN_PROFILE). Bodies with any body field (floaters, uploads, looks) are left
+// alone; a body that is not safely standing now is deferred (run again later). Idempotent.
+import type {Entity} from '@sim/engine-contract';
+import type {Db} from '../../db.ts';
+import type {WorldHost} from '../../world.ts';
+import {lookBody, describeLook} from '../../../../web/src/humanoid/look.ts';
+import {legacyLook} from '../../../../web/src/humanoid/legacy.ts';
+
+export type LookMigrationRow = {soulId: string; entityId: string; look: string; body: NonNullable<Entity['body']>};
+export type LookMigrationResult = {planned: LookMigrationRow[]; migrated: string[]; deferred: {soulId: string; reason: string}[]; skipped: {soulId: string; reason: string}[]};
+
+/** What the migration would write (nothing is changed). `socialPresets` mirrors the viewer's humanPresets flag
+ *  (the 8 audited social Souls keep their palette only in a world that shows it today). */
+export function planLegacyLooks(host: WorldHost, db: Db, {socialPresets = false} = {}): Omit<LookMigrationResult, 'migrated' | 'deferred'> {
+  const planned: LookMigrationRow[] = [], skipped: {soulId: string; reason: string}[] = [];
+  for (const row of db.liveSouls(host.worldId)) {
+    const e = host.engine.world.entities[row.entity_id] as (Entity & {human?: {soul?: unknown}}) | undefined;
+    if (!e?.human) { skipped.push({soulId: row.id, reason: 'no body in this world'}); continue; }
+    if (e.body) { skipped.push({soulId: row.id, reason: `already has a ${e.body.family}${(e.body as {params?: unknown}).params ? ' look' : e.body.modelUrl ? ' upload' : ''} body`}); continue; }
+    const look = legacyLook(row.entity_id, typeof e.human.soul === 'string' ? e.human.soul : undefined, socialPresets);
+    planned.push({soulId: row.id, entityId: row.entity_id, look: describeLook(look), body: lookBody(look) as NonNullable<Entity['body']>});
+  }
+  return {planned, skipped};
+}
+
+/** Write the planned looks (dryRun: plan only). Each write is one logged body assignment, refused while unsafe. */
+export async function migrateLegacyLooks(host: WorldHost, db: Db, {socialPresets = false, dryRun = true} = {}): Promise<LookMigrationResult> {
+  const {planned, skipped} = planLegacyLooks(host, db, {socialPresets}), migrated: string[] = [], deferred: {soulId: string; reason: string}[] = [];
+  if (dryRun) return {planned, migrated, deferred, skipped};
+  for (const p of planned) {
+    const guard = (): true => {
+      if (host.engine.world.entities[p.entityId]?.body) throw Object.assign(Error('body changed meanwhile'), {code: 'body.changed'});
+      const issue = host.engine.bodyAssignmentProblemV1?.(p.entityId, p.body); if (issue) throw Object.assign(Error(issue), {code: issue});
+      return true;
+    };
+    try { guard(); await host.enqueueChecked('body-assignment-v1', 'world:body', {contract: 'body-assignment/1', worldId: host.worldId, soulId: p.soulId, entityId: p.entityId, body: structuredClone(p.body)}, guard, () => true); migrated.push(p.soulId); }
+    catch (e) { deferred.push({soulId: p.soulId, reason: (e as {code?: string}).code ?? (e as Error).message}); }
+  }
+  return {planned, migrated, deferred, skipped};
+}
