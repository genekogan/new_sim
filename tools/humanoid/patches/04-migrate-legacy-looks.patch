+// L10 patch 04: the legacy-look data migration writes today's look of every plain humanoid Soul as a
+// core/humanoid@2 body, logged, replayed, idempotent; other bodies untouched; the engine body unchanged.
+import test from 'node:test';import assert from 'node:assert/strict';
+import {mkdtempSync,rmSync} from 'node:fs';import {join} from 'node:path';import {tmpdir} from 'node:os';
+import {fixture,invite,accept,factory} from '../test/native-owner-fixture.ts';
+import {WorldHost} from './world.ts';import {Db} from './db.ts';import {bodyV1Schema} from '@sim/protocol';
+import {migrateLegacyLooks,planLegacyLooks} from './edge/body/migrate-looks.ts';
+import {lookKey,resolveLook,legacyPreset} from '../../web/src/humanoid/look.ts';
+import {bodyProfile} from '../../../mars/viewer/engine/bodies/navigation.ts';
+import {HUMAN_PROFILE} from '../../../mars/viewer/engine/spatial/types.ts';
+test('MIGRATE LOOKS: plan, write through the log, idempotent, others untouched, replay keeps it',async t=>{
+ const dir=mkdtempSync(join(tmpdir(),'look-migrate-')),path=join(dir,'sim.db'),f=fixture(path,factory,{durableClockV1:true});f.brain.quiesce();
+ t.after(()=>{try{f.host.stop();}catch{}if(f.db.db.isOpen)f.db.close();rmSync(dir,{recursive:true,force:true});});
+ const rows:any[]=[];for(const owner of ['a','b','c']){await invite(f,owner);rows.push(await accept(f.host,f.souls.create('dev:'+owner,{name:'M '+owner,description:'migration test'})));}
+ const ent=(r:any)=>f.host.engine.world.entities[r.entity_id] as any;
+ // c already wears a floater: left alone
+ const floater={family:'floater',type:'ceramic',model:'verdelis',modelUrl:'/world-assets/littlemartians/characters/verdelis.glb',avatar:{kind:'body',modelUrl:'/world-assets/littlemartians/characters/verdelis.glb',bodyType:'ceramic'},radius:.35,hoverHeight:1.45} as any;
+ await accept(f.host,f.host.enqueueChecked('body-assignment-v1','world:body',{contract:'body-assignment/1',worldId:f.host.worldId,soulId:rows[2].id,entityId:rows[2].entity_id,body:floater},()=>true,()=>true));assert.equal(ent(rows[2]).body?.family,'floater');
+ const plan=planLegacyLooks(f.host,f.db);assert.deepEqual(plan.planned.map(p=>p.soulId),[rows[0].id,rows[1].id]);assert.equal(plan.skipped[0].soulId,rows[2].id);
+ for(const p of plan.planned){assert.ok(bodyV1Schema.safeParse(p.body).success);assert.equal(p.body.model,lookKey({preset:legacyPreset(p.entityId)}),'today\'s template by id hash');}
+ const dry=await migrateLegacyLooks(f.host,f.db);assert.equal(dry.migrated.length,0);assert.equal(ent(rows[0]).body,undefined,'a dry run changes nothing');
+ const seq=f.host.seq,run=await accept(f.host,migrateLegacyLooks(f.host,f.db,{dryRun:false}));
+ assert.deepEqual(run.migrated,[rows[0].id,rows[1].id]);assert.deepEqual(run.deferred,[]);assert.equal(f.host.seq,seq+2,'one logged event per Soul');
+ for(const r of rows.slice(0,2)){const b=ent(r).body;assert.deepEqual(b.params,{preset:legacyPreset(r.entity_id)});assert.deepEqual(resolveLook(b.params),resolveLook({preset:legacyPreset(r.entity_id)}));assert.equal(bodyProfile(ent(r)),HUMAN_PROFILE,'the engine body is today\'s');}
+ assert.deepEqual(ent(rows[2]).body,floater);
+ const again=await accept(f.host,migrateLegacyLooks(f.host,f.db,{dryRun:false}));assert.deepEqual(again.migrated,[]);assert.equal(again.skipped.length,3,'idempotent');
+ const kept=structuredClone(ent(rows[0]).body);f.host.saveSnapshot(true);const id=f.host.worldId,seed=f.host.seed;f.host.stop();f.db.close();
+ for(const mode of ['snapshot','genesis']){const db=new Db(path);if(mode==='genesis')db.db.exec('DELETE FROM snapshots');const h=new WorldHost(db,factory,seed,1e9,id,{durableClockV1:true});h.boot();
+  assert.deepEqual(h.engine.world.entities[rows[0].entity_id].body,kept,mode+' replay keeps the migrated look');h.stop();db.close();}
+});
