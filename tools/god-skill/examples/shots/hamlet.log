# example: a hamlet in 8 commands

$ eden-god place knoll --at 40,10 --param height=5 --param radius=26 --name knoll
  placed knoll [core/knoll@1] at (40, 0, 10) facing s — at (40, 10)
    seq 1 — undo with: undo
  (225 ms)
$ eden-god place cottage --at knoll --facing s --name cottage
  placed cottage [core/cottage@1] at (40, 4.47, 10) facing s — at knoll
    seq 2 — undo with: undo
  (257 ms)
$ eden-god place pond --circle 30,38,8 --name pond
  placed pond [core/pond@1] — area of 10 corners
    seq 3 — undo with: undo
  (252 ms)
$ eden-god place bench --near pond --facing pond --dir n --name pond-bench
  placed pond-bench [core/bench@1] at (30.24, 0.19, 28.11) facing s — near pond, n of it, 1.5 m away; keeps: near pond
    seq 4 — undo with: undo
  (276 ms)
$ eden-god place tree --near cottage --count 5 --dist 4
  placed tree [core/tree@1] at (45.94, 2.28, 20.29) facing s — near cottage, se of it, 4 m away; keeps: near cottage
  placed tree-2 [core/tree@1] at (51.46, 2.28, 6.93) facing s — near cottage, e of it, 4 m away; keeps: near cottage
  placed tree-3 [core/tree@1] at (40, 3.15, 0.8) facing s — near cottage, n of it, 4 m away; keeps: near cottage
  placed tree-4 [core/tree@1] at (28.54, 2.28, 6.93) facing s — near cottage, w of it, 4 m away; keeps: near cottage
  placed tree-5 [core/tree@1] at (34.06, 2.28, 20.29) facing s — near cottage, sw of it, 4 m away; keeps: near cottage
    seq 5 — undo with: undo
  (302 ms)
$ eden-god place fountain --at 18,4 --name well
  placed well [core/fountain@1] at (18, 0, 4) facing s — at (18, 4)
    seq 6 — undo with: undo
  (226 ms)
$ eden-god place lamp-post --near well --count 4 --dist 2
  placed lamp-post [core/lamp-post@1] at (20.54, 0.22, 8.39) facing s — near well, se of it, 2 m away; keeps: near well
  placed lamp-post-2 [core/lamp-post@1] at (21.96, 0.1, 0.68) facing s — near well, ne of it, 2 m away; keeps: near well
  placed lamp-post-3 [core/lamp-post@1] at (14.04, -0.2, 0.68) facing s — near well, nw of it, 2 m away; keeps: near well
  placed lamp-post-4 [core/lamp-post@1] at (15.46, -0.19, 8.39) facing s — near well, sw of it, 2 m away; keeps: near well
    seq 7 — undo with: undo
  (250 ms)
$ eden-god place dog --near cottage --dir s --dist 3 --name rex
  placed rex [core/dog@1] at (40, 3.93, 16.6) facing s — near cottage, s of it, 3 m away; keeps: near cottage
    seq 8 — undo with: undo
  (250 ms)
$ eden-god describe rex
  rex [core/dog@1] decor point — at the root
    A friendly medium dog (rounded low-poly, ~600 tris) that trots about its yard: diagonal-pair walk, head nod, wagging tail. Recolour with params fur/muzzle/ear. Behaviours: wander (default), follow, sl
    pose (40, 3.93, 16.6) facing s (yaw 0); size 0.29×0.77×1.19 m; bounds x 39.86…40.14, z 16…17.2, y 3.93…4.7; 0 colliders, ~533 tris
    params {"fur":"#b8814a","belly":"#e6cfa6","muzzle":"#e6cfa6","ear":"#7a4f2a","behavior":"wander","speed":1.1,"radius":7,"follow":""}
    constraints: ok near cottage (gap 3 m (want ≤ 4))
    behaviours: idle, sleep, follow, wander, graze, swim; cannot: fly (fly needs wings (wing.l, wing.r)); perch (perch needs two legs (leg.l, leg.r))
    ground: y 4.09, slope 14.23°, walk
    near: knoll 0 m n, cottage 3.6 m n, tree-5 5.9 m sw, tree 6.06 m se, pond 13.44 m sw, tree-4 14 m nw
  (165 ms)
$ eden-god describe cottage
  cottage [core/cottage@1] solid point — at the root
    A small one-storey cottage (placeholder block until building/1).
    pose (40, 4.47, 10) facing s (yaw 0); size 8×3.6×6 m; bounds x 36…44, z 7…13, y 4.47…8.07; 1 colliders, ~12 tris
    params {"w":8,"h":3.6,"d":6,"color":"#f1e7d2"}
    state {"paint":"#f1e7d2"}
    slots: front (stand, 0/8)
    ground: y 5, slope 1.79°, walk
    near: knoll 0 m s, rex 6 m s, tree-3 8.86 m n, tree-4 10.79 m w, tree-2 10.97 m e, tree-5 11.01 m sw
  (171 ms)
