# example: a hamlet in 8 commands

$ eden-god place knoll --at 40,10 --param height=5 --param radius=26 --name knoll
  placed knoll [core/knoll@1] at (40, 0, 10) facing s — at (40, 10)
    seq 1 — undo with: undo
  (927 ms)
$ eden-god place cottage --at knoll --facing s --name cottage
  placed cottage [core/cottage@1] at (40, 4.47, 10) facing s — at knoll
    seq 2 — undo with: undo
  (862 ms)
$ eden-god place pond --circle 30,38,8 --name pond
  placed pond [core/pond@1] — area of 10 corners
    seq 3 — undo with: undo
  (758 ms)
$ eden-god place bench --near pond --facing pond --dir n --name pond-bench
