# example: a market square

$ eden-god group market
  current group: market (every edit until `group --off`; undo it all with `undo --group market`)
  (231 ms)
$ eden-god place plaza --rect 0,0,36,28 --name square
  placed square [core/plaza@1] — area of 4 corners
    seq 1, group "market" — undo with: undo
  (1968 ms)
$ eden-god place fountain --at square --name fountain
  placed fountain [core/fountain@1] at (0, 0, 0) facing s — at square
    seq 2, group "market" — undo with: undo
  (2086 ms)
$ eden-god place bench --near fountain --count 4 --facing fountain --dist 2.5
