# Deploy settings. Copy to deploy.env (git-ignored) at the repo root, or export the variables: the environment wins.
# Read by tools/world-launcher/deploy/deploy-env.{sh,mjs}: release.sh, ship.sh and tools/cdn/publish.mjs.

# SSH target of the world-launcher box: [SIM_DEPLOY_USER@]SIM_DEPLOY_HOST (an ~/.ssh/config alias works).
SIM_DEPLOY_HOST=
SIM_DEPLOY_USER=root

# Public web/launcher base. / builds root URLs; /worlds retains a prefixed deployment.
SIM_WORLDS_BASE=/worlds

# Cloudflare account id that owns the R2 asset bucket (tools/cdn/publish.mjs --apply).
CF_ACCOUNT_ID=

# Not read from this file: tools/cdn/publish.mjs takes the R2 credentials only from the environment.
# Export EDEN_ASSETS_CREDENTIALS as the absolute path of a mode-0600 file (R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY)
# kept outside the repo.
