# Deploy settings. Copy to deploy.env (git-ignored) at the repo root, or export the variables: the environment wins.
# Read by tools/world-launcher/deploy/deploy-env.{sh,mjs}: release.sh, ship.sh, the fork and old-world scripts,
# infra/*.sh and tools/cdn/publish.mjs.

# SSH target of the world-launcher box: [SIM_DEPLOY_USER@]SIM_DEPLOY_HOST (an ~/.ssh/config alias works).
SIM_DEPLOY_HOST=
SIM_DEPLOY_USER=root

# Public origin of the isolated staging site (infra/deploy.sh smoke checks), e.g. https://staging.example.org
SIM_STAGING_ORIGIN=

# Cloudflare account id that owns the R2 asset bucket (tools/cdn/publish.mjs --apply).
CF_ACCOUNT_ID=
# Absolute path of the mode-0600 R2 credential file (R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY), outside the repo.
EDEN_ASSETS_CREDENTIALS=
